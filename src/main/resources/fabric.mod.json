{
  "schemaVersion": 1,
  "id": "bobbot",
  "version": "${version}",
  "name": "Bob",
  "description": "Bob, a companion who plays Minecraft like a player: tell him in chat or in his screen to chop wood, strip-mine, farm, sort your chests or build a schematic from the materials in a chest. He never breaks what players built.",
  "authors": [
    "Kasax"
  ],
  "contact": {
    "sources": "https://github.com/Kasax007/Bob-Bot",
    "issues": "https://github.com/Kasax007/Bob-Bot/issues"
  },
  "license": "CC-BY-4.0",
  "icon": "assets/bobbot/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.kasax.bobbot.BobBot"
    ],
    "client": [
      "net.kasax.bobbot.client.BobBotClient"
    ]
  },
  "mixins": [
    "bobbot.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": ">=0.156.0"
  }
}
